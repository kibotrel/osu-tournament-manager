{
  "name": "@apps/server",
  "private": true,
  "type": "module",
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "build": "tsc --build && tsc-alias",
    "db:migrate": "drizzle-kit migrate",
    "db:migration:create": "pnpm build && drizzle-kit generate && tsx --env-file=.env ./src/scripts/renameMigrationFile.script.ts",
    "db:migration:drop": "drizzle-kit drop",
    "db:studio": "drizzle-kit studio local",
    "dev": "nodemon --signal SIGTERM --config nodemon.json src/entrypoint.ts",
    "format": "oxfmt",
    "healthcheck": "tsx --env-file=.env ./src/scripts/healthCheck.script.ts",
    "lint": "oxlint",
    "test:unit": "vitest --config vitest.config.unit.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@packages/api-specification": "workspace:*",
    "@packages/bancho-client": "workspace:*",
    "@packages/logger": "workspace:*",
    "@packages/osu-sdk": "workspace:*",
    "@packages/shared": "workspace:*",
    "connect-redis": "9.0.0",
    "dotenv": "16.6.1",
    "drizzle-orm": "0.45.1",
    "express": "5.2.0",
    "express-openapi-validator": "5.6.2",
    "express-session": "1.19.0",
    "express-validator": "7.3.1",
    "helmet": "8.1.0",
    "pg": "8.18.0",
    "redis": "5.10.0",
    "swagger-themes": "1.4.3",
    "swagger-ui-express": "5.0.1",
    "ws": "8.19.0"
  },
  "devDependencies": {
    "@packages/config-formatter": "workspace:*",
    "@packages/config-linter": "workspace:*",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/pg": "8.23.1",
    "@types/swagger-ui-express": "4.1.8",
    "@types/ws": "8.18.2",
    "drizzle-kit": "0.31.11",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "tsx": "4.23.15",
    "vitest": "5.0.3"
  }
}
