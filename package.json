{
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@cspell/dict-fr-fr": "2.3.2",
    "@types/node": "26.6.4",
    "cspell": "10.3.6",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "nodemon": "3.1.14",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "tsc-alias": "1.9.7",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "name": "osu-tournament-manager",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "format": "pnpm --filter=@packages/* format",
    "lint": "pnpm --filter=@packages/* lint",
    "prepare": "pnpm husky && pnpm --filter=@packages/* build",
    "spellcheck": "cspell --config cspell.json --no-progress --no-summary --no-show-suggestions --no-must-find-files --gitignore ./",
    "test": "vitest --silent",
    "type-check": "pnpm -r run type-check"
  },
  "type": "module"
}
