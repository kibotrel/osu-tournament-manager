{
  "devDependencies": {
    "@commitlint/cli": "20.4.0",
    "@commitlint/config-conventional": "20.4.0",
    "@cspell/dict-fr-fr": "2.3.2",
    "@types/node": "22.13.10",
    "cspell": "9.6.2",
    "globals": "17.2.0",
    "husky": "9.1.7",
    "nodemon": "3.1.11",
    "tsc-alias": "1.8.16",
    "typescript": "6.0.3",
    "vitest": "4.0.18"
  },
  "name": "osu-tournament-manager",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "prepare": "pnpm husky && pnpm --filter=@packages/* build",
    "spellcheck": "cspell --config cspell.json --no-progress --no-summary --no-show-suggestions --no-must-find-files --gitignore ./",
    "test": "vitest --silent",
    "type-check": "pnpm -r run type-check"
  },
  "type": "module"
}
